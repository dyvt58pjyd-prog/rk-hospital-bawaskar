<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="🦷 Book Dental Appointment"
        android:textColor="@color/text_light"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPatientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/primary"
        android:hint="Patient Full Name"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etProcedure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/primary"
        android:hint="Procedure (e.g. Root Canal, Cleaning)"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/primary"
        android:focusable="false"
        android:hint="Date &amp; Time (YYYY-MM-DD HH:MM)"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/border_dark"
            android:text="Cancel"
            android:textColor="@color/text_light" />

        <Button
            android:id="@+id/btnSubmitBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:text="Submit"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
